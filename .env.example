# Copy to .env for local/production overrides. Never commit .env.
# Dev runs fine with NO .env at all (SQLite, DEBUG on, console email).

SECRET_KEY=replace-with-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=yourdomain.org,www.yourdomain.org

# Production database (Render/Railway give you this URL):
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Real email (leave unset in dev to print emails to the console):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DEFAULT_FROM_EMAIL=noreply@yourdomain.org

# Needed once DEBUG=False and you're behind HTTPS:
# CSRF_TRUSTED_ORIGINS=https://yourdomain.org
