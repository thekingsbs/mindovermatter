SECRET_KEY=generate-a-long-random-string
DEBUG=0
ALLOWED_HOSTS=mindovermatter.org,www.mindovermatter.org
CSRF_TRUSTED_ORIGINS=https://mindovermatter.org
DATABASE_URL=postgres://user:password@host:5432/dbname
# Leave EMAIL_HOST unset to print contact-form mail to the console instead.
# EMAIL_HOST=smtp.example.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=noreply@mindovermatter.org
